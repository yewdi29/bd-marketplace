NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Production must be https://blackdiamondmkt.com (non-www) — same host as Vercel primary domain
# and the Stripe webhook endpoint (https://blackdiamondmkt.com/api/stripe/webhook).
NEXT_PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=your_resend_api_key
ADMIN_ALERT_EMAIL=your-personal-email@gmail.com
PAPERCLIP_AGENT_SECRET=your_paperclip_agent_secret

# Stripe — individual membership tiers
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_MONTHLY_PRICE_ID=price_...
STRIPE_STARTER_ANNUAL_PRICE_ID=price_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_MAX_MONTHLY_PRICE_ID=price_...
STRIPE_MAX_ANNUAL_PRICE_ID=price_...

# Stripe — Enterprise (create via: node scripts/setup-enterprise-stripe.mjs)
STRIPE_ENTERPRISE_BASE_MONTHLY_PRICE_ID=price_...
STRIPE_ENTERPRISE_BASE_ANNUAL_PRICE_ID=price_...
STRIPE_ENTERPRISE_PER_SEAT_MONTHLY_PRICE_ID=price_...
STRIPE_ENTERPRISE_PER_SEAT_ANNUAL_PRICE_ID=price_...
# Optional display amounts for billing summary (cents) — must match Stripe prices
# ENTERPRISE_BASE_MONTHLY_CENTS=149900
# ENTERPRISE_PER_SEAT_MONTHLY_CENTS=9900
# ENTERPRISE_BASE_ANNUAL_CENTS=1499000
# ENTERPRISE_PER_SEAT_ANNUAL_CENTS=99000
# Enterprise Checkout uses consent_collection.terms_of_service — set Terms of service URL
# in Stripe Dashboard → Settings → Business → Public details (e.g. …/terms#enterprise-organizations)
